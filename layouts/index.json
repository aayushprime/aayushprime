{{- $.Scratch.Add "index" slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) }}
    {{- /* RelPermalink so search results navigate within whatever origin is
           serving the site, not the configured baseURL. */ -}}
    {{- /* graph/plain.html keeps raw [[wikilink]] syntax out of search results —
           notes resolve those in the page template, so .Plain still has them. */ -}}
    {{- $.Scratch.Add "index" (dict
        "title" .Title
        "content" (partial "graph/plain.html" .Plain)
        "permalink" .RelPermalink
        "summary" (partial "graph/plain.html" .Summary)) -}}
    {{- end }}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
